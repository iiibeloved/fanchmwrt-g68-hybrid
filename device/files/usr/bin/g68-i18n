#!/bin/sh
# =============================================================================
#  G68 中文覆盖投递器（FanchmWrt 25.12 / apk 基座）
#
#  只在「对应 LuCI 应用已安装」时，把 /usr/share/g68/i18n-overlay/ 下的
#  中文覆盖文件复制到 rootfs 实际位置。
#
#  为什么不用 opkg/apk 的翻译包来做：本仓还需要一些定制中文（"网络唤醒++"、
#  "上网时间控制" 等），官方 luci-i18n-*-zh-cn 的 .lmo 里没有。两者是互补的：
#    - 官方 .lmo：覆盖应用内部可翻译字符串（25.12 由 po/zh_Hans 生成，包名仍是
#      luci-i18n-*-zh-cn —— luci.mk 的 LUCI_LC_ALIAS.zh_Hans=zh-cn 保证）；
#    - 本覆盖：只替换少数 title / 静态文案，文件其余部分必须与上游版本逐行一致。
#
#  三道防线（2026-11-23 审查新增）：
#   1. pkg_installed 同时识别 apk(25.12) / opkg(24.10)，且优先读 apk 数据库，
#      不依赖 apk 3.x 改过名的子命令；
#   2. 版本指纹守卫：目标文件行数与覆盖文件不一致即跳过，防止 24.10 时代的
#      「整应用实现」覆盖打到 25.12 的新实现上（曾发现 filetransfer 的 iStoreOS
#      版 controller 777 行 vs lean 版 13 行，直接投递会把功能换掉）；
#   3. 投递后清 LuCI 25.12 的 /tmp/luci-indexcache.<hash>.json，否则开机重投递
#      后菜单与 Lua controller 仍走旧缓存，中文不生效。
# =============================================================================
OVERLAY=/usr/share/g68/i18n-overlay
MANIFEST=/usr/share/g68/i18n-manifest
INFO=/usr/lib/opkg/info
APKDB=/lib/apk/db/installed

pkg_installed() {
	# 24.10 及更早（opkg）
	if [ -f "$INFO/$1.control" ] || [ -f "$INFO/$1.list" ]; then
		return 0
	fi
	# 25.12（apk）：root layer 安装库是纯文本，每个包一段、含 "P:<包名>" 行。
	# 直接读它最稳：apk-tools 3.x 把 `apk info` 改名为 `apk query`，
	# 只靠命令行判断会在未来版本里再次静默失效。用 -F 固定串匹配，
	# 避免包名里的 '.' 被当成正则通配而误命中别的包。
	if [ -f "$APKDB" ]; then
		grep -qxF "P:$1" "$APKDB" 2>/dev/null && return 0
	fi
	if command -v apk >/dev/null 2>&1; then
		apk info -e "$1" >/dev/null 2>&1 && return 0
		apk query --installed "$1" >/dev/null 2>&1 && return 0
		apk list --installed 2>/dev/null | grep -qF "$1 " && return 0
	fi
	if command -v opkg >/dev/null 2>&1; then
		opkg list-installed 2>/dev/null | grep -qF "$1 " && return 0
	fi
	return 1
}

# 覆盖文件必须是「只改了中文字符串」的同版副本：行数与 rootfs 里已装版本一致。
# menu.d/*.json 允许缩进/换行差异，其它源码类（.lua/.htm/.js）严格校验。
compat_ok() {
	_o="$1"; _t="$2"
	case "$_o" in *.json) return 0 ;; esac
	[ -f "$_t" ] || return 0
	_a=$(wc -l < "$_o" 2>/dev/null || echo 0)
	_b=$(wc -l < "$_t" 2>/dev/null || echo 0)
	if [ "$_a" -gt "$_b" ]; then _d=$((_a - _b)); else _d=$((_b - _a)); fi
	[ "$_d" -le 2 ] && return 0
	return 1
}

apply_all() {
	applied=0; skipped=0; guarded=0; changed=0
	while IFS=$(printf '\t') read -r pkg path; do
		case "$pkg" in ''|\#*) continue ;; esac
		[ -f "$OVERLAY/$path" ] || continue
		if ! pkg_installed "$pkg"; then
			# 应用已卸载/未安装：删掉旧的中文覆盖，避免残留
			[ -f "/$path" ] && rm -f "/$path"
			skipped=$((skipped+1))
			continue
		fi
		if ! compat_ok "$OVERLAY/$path" "/$path"; then
			echo "g68-i18n: [跳过·版本不符] $path —— 上游实现已变，拒绝旧覆盖（中文由 luci-i18n-*-zh-cn 提供）"
			guarded=$((guarded+1))
			continue
		fi
		mkdir -p "/$(dirname "$path")"
		if ! cmp -s "$OVERLAY/$path" "/$path"; then
			changed=1
		fi
		cp -f "$OVERLAY/$path" "/$path" && applied=$((applied+1))
	done < "$MANIFEST"

	# LuCI 25.12 把菜单树缓存在 /tmp/luci-indexcache.<hash>.json；
	# 不删的话开机重投递后看到的仍是旧英文菜单 / 旧 Lua controller。
	if [ "$changed" = "1" ]; then
		rm -f /tmp/luci-indexcache*.json 2>/dev/null || true
		rm -rf /tmp/luci-modulecache 2>/dev/null || true
	fi
	echo "g68-i18n: 已投递 $applied 个文件，跳过 $skipped 项（应用未安装），版本不符拦截 $guarded 项"
}

case "${1:-apply}" in
	apply) apply_all ;;
	status)
		while IFS=$(printf '\t') read -r pkg path; do
			case "$pkg" in ''|\#*) continue ;; esac
			if pkg_installed "$pkg"; then
				if compat_ok "$OVERLAY/$path" "/$path"; then s="可投递"; else s="版本不符·已拦截"; fi
				echo "[已安装] $pkg -> $path ($s)"
			else
				echo "[未安装] $pkg -> $path"
			fi
		done < "$MANIFEST" ;;
	*) echo "用法: g68-i18n apply|status" >&2; exit 1 ;;
esac
